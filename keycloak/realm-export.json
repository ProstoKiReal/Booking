{
  "realm": "events-realm",
  "displayName": "События",
  "enabled": true,
  "loginTheme": "booking",
  "accountTheme": "booking",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru"],
  "defaultLocale": "ru",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "admin",    "description": "Administrator" },
      { "name": "seller",   "description": "Seller" },
      { "name": "customer", "description": "Customer" }
    ]
  },
  "clients": [
    {
      "clientId": "events-api",
      "enabled": true,
      "publicClient": true,
      "name": "События",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.claim": "true"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": ["profile", "email", "roles"]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin"],
      "clientRoles": {
        "account": ["manage-account", "view-profile"]
      }
    },
    {
      "username": "seller-user",
      "enabled": true,
      "email": "seller@example.com",
      "emailVerified": true,
      "firstName": "Seller",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "seller", "temporary": false }],
      "realmRoles": ["seller"],
      "clientRoles": {
        "account": ["manage-account", "view-profile"]
      }
    },
    {
      "username": "customer-user",
      "enabled": true,
      "email": "customer@example.com",
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "customer", "temporary": false }],
      "realmRoles": ["customer"],
      "clientRoles": {
        "account": ["manage-account", "view-profile"]
      }
    }
  ]
}